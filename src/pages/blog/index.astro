---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Blog" description="Writing and notes">
  <header class="page-head">
    <span class="eyebrow"><span class="dot"></span> Blog</span>
    <h1 class="gradient-text">Writing</h1>
    <p class="lede">Notes, essays, and updates on what I'm reading and working on.</p>
  </header>

  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class="card post">
          <time class="muted" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          <h2>{post.data.title}</h2>
          <p class="muted">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <span class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</span>
          )}
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .page-head { padding-top: 3.5rem; margin-bottom: 2.5rem; }
  .page-head h1 { margin-top: 1.25rem; }
  .lede { font-size: 1.125rem; }
  .posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .post { display: block; }
  .post time { font-size: 0.8125rem; font-variant-numeric: tabular-nums; }
  .post h2 { margin: 0.35rem 0 0.35rem; font-size: 1.15rem; }
  .post p { font-size: 0.9375rem; }
  .tags { display: flex; gap: 0.4rem; margin-top: 0.75rem; }
  .tag {
    font-size: 0.75rem;
    color: var(--text-secondary);
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
  }
</style>
