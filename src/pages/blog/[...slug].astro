---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <p class="muted meta">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        {post.data.updatedDate && <> · Updated {fmt(post.data.updatedDate)}</>}
        {post.data.tags.length > 0 && <> · {post.data.tags.join(', ')}</>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p class="back"><a href="/blog/">← All posts</a></p>
</Base>

<style>
  header { padding-top: 3.5rem; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
  header h1 { margin: 0 0 0.75rem; font-size: clamp(2rem, 5vw, 2.6rem); }
  .meta { font-size: 0.875rem; margin: 0; }
  .prose { font-size: 1.0625rem; line-height: 1.75; }
  .prose :global(h2) { font-size: 1.3rem; margin-top: 2.5rem; }
  .prose :global(li) { margin: 0.25rem 0; }
  .prose :global(li::marker) { color: var(--muted); }
  .back { margin-top: 4rem; font-size: 0.875rem; }
  .back a { text-decoration: none; color: var(--muted); }
  .back a:hover { color: var(--text); }
</style>
