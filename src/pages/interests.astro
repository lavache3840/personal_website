---
import Base from '../layouts/Base.astro';
import { interests } from '../data/interests';
---

<Base title="Interests" description="The things I'm curious about lately">
  <header class="page-head">
    <span class="eyebrow"><span class="dot dot-pink"></span> Interests</span>
    <h1 class="gradient-text">What I'm curious about</h1>
    <p class="lede">
      The topics, rabbit holes, and side quests that keep me up at night (sometimes literally).
    </p>
  </header>

  <div class="interests">
    {interests.map((i, n) => (
      <article class="card">
        <span class="num">{String(n + 1).padStart(2, '0')}</span>
        <h3>{i.title}</h3>
        <p>{i.summary}</p>
      </article>
    ))}
  </div>
</Base>

<style>
  .page-head { padding-top: 3.5rem; margin-bottom: 2.5rem; }
  .page-head h1 { margin-top: 1.25rem; }
  .lede { font-size: 1.125rem; max-width: 36rem; }
  .interests { display: grid; gap: 0.75rem; }
  .num {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.4rem;
  }
  .card p { font-size: 0.9375rem; }
</style>
